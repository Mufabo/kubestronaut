# Tier 2 lab environment: three VirtualBox VMs running a kubeadm cluster.
# Requires VirtualBox and Vagrant on the host (see envs/vagrant/README.md).
#
# Build it with the driver, not with plain `vagrant up`:
#   Windows:        .\kbook-vm.ps1 build
#   Linux / macOS:  ./kbook-vm.sh build
# The driver runs the provisioners below one stage at a time and saves the
# snapshots `prereqs`, `cluster`, and `cluster-prev` between stages. Every
# provisioner is `run: "never"`, so `vagrant up` alone only boots the VMs.
#
# Versions come from versions.env, the single source of truth. This file reads it
# the same way the Makefile does, so there is no second copy of any version.

def read_versions(path)
  File.readlines(path).each_with_object({}) do |line, h|
    line = line.strip
    next if line.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    h[key.strip] = value.to_s.split("#", 2).first.to_s.strip
  end
end

VERSIONS = read_versions(File.expand_path("../../versions.env", __dir__))
# The driver sets KBOOK_K8S_VERSION to build the cluster-prev snapshot at
# K8S_PREV_VERSION; otherwise every stage uses K8S_VERSION.
K8S_VERSION = ENV.fetch("KBOOK_K8S_VERSION", VERSIONS.fetch("K8S_VERSION"))
K8S_MINOR = K8S_VERSION.sub(/\.\d+$/, "").sub(/^v/, "")
SNAPSHOT = ENV.fetch("KBOOK_SNAPSHOT", "")
# One CPU per VM by default. On Windows with WSL2 or Docker Desktop, Hyper-V owns
# the CPU's virtualization extensions and VirtualBox runs on top of it; there,
# Ubuntu guests with more than one CPU often hang early in boot. Hosts without
# Hyper-V can set KBOOK_VM_CPUS=2 before building.
CPUS = Integer(ENV.fetch("KBOOK_VM_CPUS", "1"))

BASE_NODES = {
  "cp1"   => { ip: "192.168.56.10", role: "control-plane", memory: 2048, ssh_port: 2222 },
  "node1" => { ip: "192.168.56.11", role: "worker",        memory: 1536, ssh_port: 2200 },
  "node2" => { ip: "192.168.56.12", role: "worker",        memory: 1536, ssh_port: 2201 },
}.freeze
# Chapter 18's highly available control plane (Part ha): two more control plane
# nodes and an HAProxy load balancer. They exist only with KBOOK_HA=1, which the
# driver's build-ha and restore-ha commands set, so every other command sees the
# three base VMs alone. node1 and node2 stay halted while they run.
HA_NODES = {
  "cp2" => { ip: "192.168.56.13", role: "ha-control-plane", memory: 1536, ssh_port: 2202 },
  "cp3" => { ip: "192.168.56.14", role: "ha-control-plane", memory: 1536, ssh_port: 2203 },
  "lb"  => { ip: "192.168.56.15", role: "load-balancer",    memory: 1024, ssh_port: 2204 },  # 512 MB cannot unpack the box's initrd
}.freeze
HA = ENV.fetch("KBOOK_HA", "") == "1"
NODES = HA ? BASE_NODES.merge(HA_NODES) : BASE_NODES
HOSTS = BASE_NODES.merge(HA_NODES).map { |name, node| "#{node[:ip]} #{name}" }.join("\n")
# lb forwards to the API servers of every control plane node.
LB_BACKENDS = BASE_NODES.merge(HA_NODES).select { |_, n| n[:role].end_with?("control-plane") }
                        .map { |name, n| "#{name}:#{n[:ip]}" }.join(" ")

Vagrant.configure("2") do |config|
  config.vm.box = VERSIONS.fetch("VAGRANT_BOX")
  config.vm.box_version = VERSIONS.fetch("VAGRANT_BOX_VERSION")
  config.vm.box_check_update = false
  # The first boot of a fresh box can take several minutes on a slow host.
  config.vm.boot_timeout = 600
  # envs/vagrant is /vagrant in every VM; the build's shared state (join
  # command, SSH key) lives in /vagrant/.state, which git ignores.
  config.vm.synced_folder ".", "/vagrant", type: "virtualbox"

  NODES.each do |name, node|
    config.vm.define name do |vm|
      vm.vm.hostname = name
      vm.vm.network "private_network", ip: node[:ip]
      # A fixed SSH port per VM: Vagrant would otherwise hand out ports in creation
      # order, and a VM created while another was off could take its port.
      vm.vm.network "forwarded_port", id: "ssh", guest: 22, host: node[:ssh_port],
        host_ip: "127.0.0.1", auto_correct: false
      vm.vm.provider "virtualbox" do |vb|
        vb.name = "kbook-#{name}"
        vb.cpus = CPUS
        vb.memory = node[:memory]
      end
      if node[:role] == "control-plane"
        # Readers work on cp1, with the whole book at /kbook.
        vm.vm.synced_folder "../..", "/kbook", type: "virtualbox"
      end

      vm.vm.provision "os", type: "shell", run: "never", path: "bootstrap-os.sh",
        env: { "NODE_NAME" => name, "NODE_IP" => node[:ip], "HOSTS" => HOSTS }
      if node[:role] == "load-balancer"
        vm.vm.provision "lb", type: "shell", run: "never", path: "bootstrap-lb.sh",
          env: { "BACKENDS" => LB_BACKENDS }
      else
        vm.vm.provision "k8s-tools", type: "shell", run: "never", path: "bootstrap-tools.sh",
          env: { "K8S_VERSION" => K8S_VERSION, "K8S_MINOR" => K8S_MINOR, "NODE_IP" => node[:ip] }
      end
      if name == "cp1" && HA
        # cp1's base snapshots predate the HA VMs: add them to /etc/hosts and SSH.
        vm.vm.provision "ha-hosts", type: "shell", run: "never", path: "bootstrap-ha-hosts.sh",
          env: { "HOSTS" => HOSTS }
      end
      if node[:role] == "control-plane"
        vm.vm.provision "cluster-init", type: "shell", run: "never", path: "bootstrap-control-plane.sh",
          env: {
            "K8S_VERSION" => K8S_VERSION,
            "CALICO_VERSION" => VERSIONS.fetch("CALICO_VERSION"),
            "NODE_IP" => node[:ip],
          }
        vm.vm.provision "network-ready", type: "shell", run: "never", path: "bootstrap-network-ready.sh"
      elsif node[:role] == "worker"
        vm.vm.provision "cluster-join", type: "shell", run: "never", path: "bootstrap-worker.sh"
      end
      vm.vm.provision "mark", type: "shell", run: "never",
        inline: "mkdir -p /etc/kbook && printf '%s\\n' \"$1\" > /etc/kbook/snapshot", args: [SNAPSHOT]
    end
  end
end

#!/usr/bin/env python3
"""labhttp: a small HTTP(S) server for the netlab labs.

    labhttp --port 8080 [--bind 0.0.0.0] [--name web]
            [--vhost HOST=TEXT ...]
            [--cert server.crt --key server.key [--client-ca ca.crt]]

Paths:
    /              "hello from <name>", or the TEXT of a matching --vhost
    /headers       echoes the request line and headers back
    /status/<NNN>  answers with that status code
    /redirect      301 to /
    anything else  404

With --cert and --key it speaks HTTPS. With --client-ca as well, every client
must present a certificate signed by that CA (mutual TLS), and / greets the
client by the certificate's common name.
"""
import argparse
import http.server
import socketserver
import ssl
import sys


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def make_handler(opts):
    vhosts = {}
    for v in opts.vhost:
        host, _, text = v.partition("=")
        vhosts[host.lower()] = text

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "labhttp/1.0"
        sys_version = ""

        def send_text(self, code, text, extra=None):
            body = (text + "\n").encode()
            self.send_response(code)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("X-Served-By", opts.name)
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def client_name(self):
            try:
                cert = self.connection.getpeercert()
            except (AttributeError, ValueError):
                return None
            if not cert:
                return None
            for rdn in cert.get("subject", ()):
                for key, value in rdn:
                    if key == "commonName":
                        return value
            return None

        def do_GET(self):
            path = self.path.split("?", 1)[0]
            host = (self.headers.get("Host") or "").split(":")[0].lower()
            if path == "/":
                text = vhosts.get(host, f"hello from {opts.name}")
                who = self.client_name()
                if who:
                    text = f"{text} (client certificate: {who})"
                self.send_text(200, text)
            elif path == "/headers":
                lines = [self.requestline] + [f"{k}: {v}" for k, v in self.headers.items()]
                self.send_text(200, "\n".join(lines))
            elif path.startswith("/status/") and path[8:].isdigit():
                code = int(path[8:])
                self.send_text(code, f"status {code}")
            elif path == "/redirect":
                self.send_text(301, "moved to /", {"Location": "/"})
            else:
                self.send_text(404, "not found")

        do_HEAD = do_GET

        def do_POST(self):
            length = int(self.headers.get("Content-Length") or 0)
            data = self.rfile.read(length).decode(errors="replace")
            self.send_text(200, f"received {length} bytes: {data}")

        def log_message(self, fmt, *args):
            sys.stderr.write("%s - %s\n" % (self.client_address[0], fmt % args))
            sys.stderr.flush()

    return Handler


def main():
    ap = argparse.ArgumentParser(description="small HTTP(S) server for the netlab")
    ap.add_argument("--port", type=int, required=True)
    ap.add_argument("--bind", default="0.0.0.0")
    ap.add_argument("--name", default="labhttp")
    ap.add_argument("--vhost", action="append", default=[], metavar="HOST=TEXT")
    ap.add_argument("--cert")
    ap.add_argument("--key")
    ap.add_argument("--client-ca")
    opts = ap.parse_args()

    httpd = Server((opts.bind, opts.port), make_handler(opts))
    if opts.cert or opts.key:
        if not (opts.cert and opts.key):
            ap.error("--cert and --key go together")
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(opts.cert, opts.key)
        if opts.client_ca:
            ctx.load_verify_locations(opts.client_ca)
            ctx.verify_mode = ssl.CERT_REQUIRED
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
    scheme = "https" if opts.cert else "http"
    sys.stderr.write(f"labhttp {opts.name}: serving {scheme} on {opts.bind}:{opts.port}\n")
    sys.stderr.flush()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()

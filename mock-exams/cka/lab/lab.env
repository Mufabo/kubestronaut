# Mock exam: full CKA simulator (killer.sh style), on the Tier 2 VMs. Run with
# EXAM=cka on cp1, from the cluster snapshot (every node at K8S_VERSION).
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=cka-work
# Every namespace the exam owns (cka-infra is created by the reader, question 2);
# the test loop proves verify leaves all of them untouched.
LAB_SNAPSHOT_NS="cka-team cka-infra cka-work cka-net cka-data cka-ops"
# The exam's own contexts (same cluster and user as kbook-vm).
LAB_EXTRA_CONTEXTS="cka-a cka-b"
EXAM_MINUTES=120
EXAM_PASS_PERCENT=66
# Answer files go under COURSE/<question>/; setup creates the folders.
COURSE=/tmp/kbook/cka
CP_IP=192.168.56.10

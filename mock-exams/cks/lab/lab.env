# Mock exam: full CKS simulator (killer.sh style), on the Tier 2 VMs. Run with
# EXAM=cks on cp1, from the cluster snapshot. Setup installs etcdctl, gVisor, and
# Falco; three questions change the API server, so only a snapshot restore undoes
# an attempt completely.
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=cks-prod
# Every namespace the exam owns; the test loop proves verify leaves all of them untouched.
LAB_SNAPSHOT_NS="cks-shop cks-ci cks-sys cks-pci cks-sbx cks-prod cks-run"
# The exam's own contexts (same cluster and user as kbook-vm).
LAB_EXTRA_CONTEXTS="cks-a cks-b"
EXAM_MINUTES=120
EXAM_PASS_PERCENT=67
# Answer files go under COURSE/<question>/; setup creates the folders.
COURSE=/tmp/kbook/cks
APISERVER_MANIFEST=/etc/kubernetes/manifests/kube-apiserver.yaml
ENC_CONFIG=/etc/kubernetes/enc/cks.yaml
AUDIT_POLICY=/etc/kubernetes/audit/cks-policy.yaml
AUDIT_LOG=/var/log/kubernetes/audit/cks.log

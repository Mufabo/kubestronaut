# Mock exam: full CKAD simulator (killer.sh style). Run with EXAM=ckad.
LAB_TIER=1
LAB_NS=ckad-design
# Every namespace the exam owns; CI proves verify leaves all of them untouched.
LAB_SNAPSHOT_NS="ckad-design ckad-deploy ckad-ops ckad-sec ckad-quota ckad-net"
# The exam's own contexts (same cluster and user as kind-kbook).
LAB_EXTRA_CONTEXTS="ckad-a ckad-b"
EXAM_MINUTES=120
EXAM_PASS_PERCENT=66
# Answer files go under COURSE/<question>/; setup creates the folders.
COURSE=/tmp/kbook/ckad
# The image question 1 builds; teardown removes it from the local Docker.
CKAD_IMAGE=ckad-web:2.0
# The CRD question 17 uses; setup creates it, teardown deletes it.
CKAD_CRD=caches.ckad.kbook.io

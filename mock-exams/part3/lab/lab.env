# Mock exam: Part III simulator (killer.sh style), on the Tier 2 VMs. Run with
# EXAM=part3 on cp1, from the cluster-prev snapshot (every node at K8S_PREV_VERSION).
LAB_TIER=2
LAB_SNAPSHOT=cluster-prev
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=p3-apps
# Every namespace the exam owns; the test loop proves verify leaves all of them untouched.
LAB_SNAPSHOT_NS="p3-sched p3-ops p3-net p3-data p3-apps"
# The exam's own contexts (same cluster and user as kbook-vm).
LAB_EXTRA_CONTEXTS="p3-a p3-b"
EXAM_MINUTES=120
EXAM_PASS_PERCENT=66
# Answer files go under COURSE/<question>/; setup creates the folders.
COURSE=/tmp/kbook/part3
CP_IP=192.168.56.10

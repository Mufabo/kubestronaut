# Mock exam: full CKAD simulator, set 2 (killer.sh style). Run with EXAM=ckad2.
LAB_TIER=1
LAB_NS=ckad2-design
# Every namespace the exam owns; CI proves verify leaves all of them untouched.
LAB_SNAPSHOT_NS="ckad2-design ckad2-deploy ckad2-ops ckad2-sec ckad2-quota ckad2-net"
# The exam's own contexts (same cluster and user as kind-kbook).
LAB_EXTRA_CONTEXTS="ckad2-a ckad2-b"
EXAM_MINUTES=120
EXAM_PASS_PERCENT=66
# Answer files go under COURSE/<question>/; setup creates the folders.
COURSE=/tmp/kbook/ckad2
# The image question 1 builds; teardown removes it from the local Docker.
CKAD_IMAGE=ckad2-api:1.1
# The node port question 19 asks for.
NODE_PORT=30180

# Mock exam: Part VI simulator (killer.sh style). Run with EXAM=part6.
LAB_TIER=1
LAB_PROFILE=nocni
# Setup builds a brand-new cluster (Cilium, Multus, CNI plugins, and a node
# firewall fault are installed on it), so every attempt starts clean.
LAB_RESETS_CLUSTER=1
LAB_NS=p6-core
LAB_SNAPSHOT_NS="p6-core p6-red p6-batch p6-fabric p6-shop"
LAB_SNAPSHOT_CLUSTER="ciliumpodippools.cilium.io,network-attachment-definitions.k8s.cni.cncf.io"
LAB_SNAPSHOT_NODES=1
LAB_EXTRA_CONTEXTS="p6-a"
EXAM_MINUTES=60
EXAM_PASS_PERCENT=67
COURSE=/tmp/kbook/part6

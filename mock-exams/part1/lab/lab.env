# Mock exam: Part I simulator (killer.sh style). Run with EXAM=part1.
LAB_TIER=1
LAB_NS=p1-io
# Every namespace the exam owns (p1-staging is created by the reader, question 15);
# CI proves verify leaves all of them untouched.
LAB_SNAPSHOT_NS="p1-io p1-europa p1-titan p1-callisto p1-ganymede p1-staging"
# The exam's own contexts (same cluster and user as kind-kbook). Readers switch
# to them per question, so require_lab_cluster must accept them.
LAB_EXTRA_CONTEXTS="p1-a p1-b"
EXAM_MINUTES=120
EXAM_PASS_PERCENT=66
# Answer files go under COURSE/<question>/; setup creates the folders.
COURSE=/tmp/kbook/part1

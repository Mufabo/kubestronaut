# Single source of truth for every pinned version in the book.
# Bump here, then let CI re-run every lab. VERIFY these against upstream
# releases (and the current CNCF exam curricula) before each edition.

# Kubernetes version the book and labs are written against.
# Exams typically lag the newest upstream minor by a release or two.
K8S_VERSION=v1.35.0
KIND_NODE_IMAGE=kindest/node:v1.35.0

# kind CLI version used in docs and CI (must support the node image above).
KIND_VERSION=v0.31.0

# Name of the Tier 1 cluster created by `make cluster`.
CLUSTER_NAME=kbook

# Tier 2 (envs/vagrant): VirtualBox VMs built with kubeadm.
# K8S_PREV_VERSION is the cluster in the `cluster-prev` snapshot, which the
# upgrade chapter (19) upgrades to K8S_VERSION. Use one minor below K8S_VERSION,
# newest patch; check https://pkgs.k8s.io/core:/stable:/v1.34/deb/Packages
K8S_PREV_VERSION=v1.34.12
VAGRANT_BOX=generic/ubuntu2204
VAGRANT_BOX_VERSION=4.3.12

# Pins for Chapter 03. Re-check upstream releases before each edition.
JQ_VERSION=1.8.2          # https://github.com/jqlang/jq/releases
YQ_VERSION=v4.54.1        # mikefarah/yq (Go). NOT the Python 'yq' package

# CNI for the Tier 1 cluster: Calico enforces NetworkPolicy, which kindnet does not.
# Released 2026-08-30; https://github.com/projectcalico/calico/releases
CALICO_VERSION=v3.32.2

# etcdctl and etcdutl for Chapter 20, matching the etcd image kubeadm v1.35 runs (3.6.6-0)
ETCD_VERSION=v3.6.6

# metrics-server: resource metrics for kubectl top and the HPA (Chapter 25).
# Released 2026-07-13; https://github.com/kubernetes-sigs/metrics-server/releases
METRICS_SERVER_VERSION=v0.9.0

# Lint tool used by `make lint` and CI (npm package markdownlint-cli2).
# Pinned because new markdownlint releases add rules (MD060 in 0.41) that break the build.
MARKDOWNLINT_CLI2_VERSION=0.23.3

# Gateway API CRDs (standard channel) installed by the Chapter 12 lab.
# Released 2026-07-16; https://github.com/kubernetes-sigs/gateway-api/releases
GATEWAY_API_VERSION=v1.6.1

# Tool pins introduced by later chapters (uncomment when first used).
# Helm 3 CLI used by the Chapter 14 lab and CI (https://github.com/helm/helm/releases).
# Released 2026-08-14. The CI job downloads it and checks the .sha256sum file.
HELM_VERSION=v3.21.4

# Chapter 12 Task 6: the Ingress controller installed with Helm (chart traefik/traefik from
# https://traefik.github.io/charts; chart 41.7.1 ships Traefik v3.7.14)
TRAEFIK_CHART_VERSION=41.7.1
# TRIVY_VERSION=
# FALCO_VERSION=
# KUBE_BENCH_VERSION=

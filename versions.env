# Single source of truth for every pinned version in the book.
# Bump here, then let CI re-run every lab. VERIFY these against upstream
# releases (and the current CNCF exam curricula) before each edition.

# Kubernetes version the book and labs are written against.
# Exams typically lag the newest upstream minor by a release or two.
K8S_VERSION=v1.37.0
KIND_NODE_IMAGE=kindest/node:v1.37.0

# kind CLI version used in docs and CI (must support the node image above).
KIND_VERSION=v0.33.0

# Name of the Tier 1 cluster created by `make cluster`.
CLUSTER_NAME=kbook

# Tier 2 (envs/vagrant): VirtualBox VMs built with kubeadm.
# K8S_PREV_VERSION is the cluster in the `cluster-prev` snapshot, which the
# upgrade chapter (19) upgrades to K8S_VERSION. Use one minor below K8S_VERSION,
# newest patch; check https://pkgs.k8s.io/core:/stable:/v1.36/deb/Packages
K8S_PREV_VERSION=v1.36.5
VAGRANT_BOX=generic/ubuntu2204
VAGRANT_BOX_VERSION=4.3.12

# Pins for Chapter 03. Re-check upstream releases before each edition.
JQ_VERSION=1.8.2          # https://github.com/jqlang/jq/releases
YQ_VERSION=v4.54.1        # mikefarah/yq (Go). NOT the Python 'yq' package

# CNI for the Tier 1 cluster: Calico, in place of kind's default kindnet (which enforced no NetworkPolicy before kind v0.24).
# Released 2026-10-01, tested on Kubernetes 1.35 to 1.37; https://github.com/projectcalico/calico/releases
CALICO_VERSION=v3.33.0

# etcdctl and etcdutl for Chapter 20, matching the etcd image kubeadm v1.37 runs (3.7.0-0)
ETCD_VERSION=v3.7.0

# gVisor (runsc and its containerd shim) for Chapter 33, on the Tier 2 workers;
# releases are dated weekly at https://github.com/google/gvisor/releases
GVISOR_VERSION=release-20261005.0

# metrics-server: resource metrics for kubectl top and the HPA (Chapter 25).
# Released 2026-07-13; https://github.com/kubernetes-sigs/metrics-server/releases
METRICS_SERVER_VERSION=v0.9.0

# Lint tool used by `make lint` and CI (npm package markdownlint-cli2).
# Pinned because new markdownlint releases add rules (MD060 in 0.41) that break the build.
MARKDOWNLINT_CLI2_VERSION=0.23.3

# shellcheck for make lint, from its GitHub release (CI checks the SHA-256); Ubuntu's
# package is older and reports SC2317 where 0.11 reports SC2329.
SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# Gateway API CRDs (standard channel) installed by the Chapter 12 lab.
# Released 2026-07-16; https://github.com/kubernetes-sigs/gateway-api/releases
GATEWAY_API_VERSION=v1.6.1

# Tool pins introduced by later chapters (uncomment when first used).
# Helm 3 CLI used by the Chapter 14 lab and CI (https://github.com/helm/helm/releases).
# Released 2026-08-14. The CI job downloads it and checks the .sha256sum file.
HELM_VERSION=v3.21.4

# Chapter 12 Task 6: the Ingress controller installed with Helm (chart traefik/traefik from
# https://traefik.github.io/charts; chart 41.7.1 ships Traefik v3.7.14)
TRAEFIK_CHART_VERSION=41.7.1

# Chapter 11 Task 6: MetalLB gives LoadBalancer Services an address on kind
# (config/manifests/metallb-native.yaml). Released 2026-11-04;
# https://github.com/metallb/metallb/releases
METALLB_VERSION=v0.16.2

# Chapter 25 Task 6: the VPA recommender (CRDs, RBAC, and recommender from
# vertical-pod-autoscaler/deploy at tag vertical-pod-autoscaler-<v>). Released 2026-10-21;
# https://github.com/kubernetes/autoscaler/releases
VPA_VERSION=1.8.1

# Chapter 24 Task 6: the operator installed with Helm (chart jetstack/cert-manager
# from https://charts.jetstack.io)
CERT_MANAGER_VERSION=v1.21.2
# Chapter 36 Part mesh: Istio, installed with istioctl from its GitHub release
# (istioctl-<v>-linux-amd64.tar.gz, checked against this SHA-256).
ISTIO_VERSION=1.31.3
ISTIO_SHA256=382c3004ce2e9c5ed3064b092ae0da7f6bbe30c766a1be282f45725add004860
# Chapter 34: image and configuration scanning (aquasecurity/trivy), and signing
# (sigstore/cosign), from their GitHub releases, checked against these SHA-256 sums
# (trivy_<v>_Linux-64bit.tar.gz and cosign-linux-amd64).
TRIVY_VERSION=v0.76.1
TRIVY_SHA256=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0
COSIGN_VERSION=v3.1.4
COSIGN_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
# Falco for Chapter 35, from its apt repository (https://download.falco.org/packages/deb)
FALCO_VERSION=0.45.2
# kube-bench for Chapter 30 (CIS Kubernetes Benchmark; its newest benchmark is cis-1.12)
KUBE_BENCH_VERSION=v0.16.0

# The EPUB build (make epub, .github/workflows/epub.yml): pandoc from its GitHub
# release, checked against the release's SHA-256, and mermaid-cli for the diagrams.
PANDOC_VERSION=3.12.1
PANDOC_SHA256=d0c90410e90204c9ca83b8539fac5c7aed01fd537207e4585849f8abc5df20b8
MERMAID_CLI_VERSION=11.17.0

# ---- Parts V to X: the CKNE chapters ------------------------------------------
# Tier 0 (Part V): the netlab container, built from envs/netlab. Base image is
# Debian 13 "trixie", pinned to a point release so every reader gets the same
# tool versions (iproute2 6.15, tcpdump 4.99, nftables 1.1, dnsmasq 2.91, OpenSSL 3.5).
NETLAB_BASE_IMAGE=debian:13.7-slim
# Tag of the locally built image. Bump it whenever envs/netlab changes, so
# `make netlab` rebuilds instead of reusing an old image.
NETLAB_IMAGE=kbook-netlab:1
# Name of the running container. Lab scripts only ever touch this container.
NETLAB_CONTAINER=kbook-netlab
# Cilium, the CNI of the `cilium` cluster profile (envs/kind/profiles), from the
# Helm chart cilium/cilium (https://helm.cilium.io); https://github.com/cilium/cilium/releases
CILIUM_VERSION=1.20.5
# The cilium CLI that readers install in Chapter 49 (https://github.com/cilium/cilium-cli/releases)
CILIUM_CLI_VERSION=v0.20.3
# The probe image for connectivity checks and node debugging (tcpdump, curl, dig, ...)
NETSHOOT_IMAGE=nicolaka/netshoot:v0.14
# The Kubernetes test server (agnhost netexec: /clientip, /hostname, ...) used as a
# lab backend; https://registry.k8s.io/v2/e2e-test-images/agnhost/tags/list
AGNHOST_IMAGE=registry.k8s.io/e2e-test-images/agnhost:2.66.1
# Chapter 51: Multus (thick plugin) from its GitHub release manifest
# (deployments/multus-daemonset-thick.yml at this tag; image tag <version>-thick).
# Released 2026-11-05; https://github.com/k8snetworkplumbingwg/multus-cni/releases
MULTUS_VERSION=v4.3.2
# The CNI reference plugins (macvlan, ipvlan, bridge, static) that Chapter 51 copies
# onto the kind nodes, which ship only ptp, host-local, loopback, and portmap.
# Released 2026-03-16; https://github.com/containernetworking/plugins/releases
CNI_PLUGINS_VERSION=v1.9.1
CNI_PLUGINS_SHA256=b98f74a0f8522f0a83867178729c1aa70f2158f90c45a2ca8fa791db1c76b303

LAB_NS=ch06-shop
LAB_TIER=1
# Every namespace the lab owns. ch06-payments is created by the reader (Task 2).
LAB_COLOR_NS="ch06-red ch06-green ch06-blue"
LAB_SNAPSHOT_NS="ch06-shop ch06-red ch06-green ch06-blue ch06-payments"
LAB_ANSWER_NS=/tmp/ch06-ns.txt
LAB_ANSWER_PODS=/tmp/ch06-not-running.txt
# Node label for Task 5. Cluster-scoped, so setup and teardown remove it from every node.
LAB_NODE_LABEL=ch06.kbook.io/disk

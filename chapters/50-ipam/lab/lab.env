LAB_TIER=1
LAB_PROFILE=nocni
# Setup builds a brand-new cluster each time, with Cilium in multi-pool IPAM mode.
LAB_RESETS_CLUSTER=1
LAB_NS=ch50-ipam
LAB_SNAPSHOT_NS="ch50-ipam ch50-blue ch50-batch"
# The pools are cluster-scoped: verify must not change them either.
LAB_SNAPSHOT_CLUSTER=ciliumpodippools.cilium.io
LAB_ANSWERS=/tmp/kbook/ch50

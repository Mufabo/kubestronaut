# Tier 2: runs on cp1, starting from the VMs' cluster snapshot. The tasks change
# node1 and node2 (a service, a user, AppArmor, seccomp, the kubelet); setup and
# teardown undo the lab's own changes, and a snapshot restore undoes everything.
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=ch32-hardening
SERVICE_FILE=/tmp/ch32-service.txt
LEGACY_PORT=8081
APPARMOR_PROFILE=kbook-deny-write
SECCOMP_PROFILE=profiles/no-chmod.json

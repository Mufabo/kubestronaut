# Tier 2: runs on cp1 in the VMs (envs/vagrant). The reader builds the cluster in
# this lab, so it starts from a snapshot without one.
# Parts: single = cp1 with two workers, from prereqs (the default);
#        ha = three control plane nodes behind a load balancer, from ha-prereqs
#             (kbook-vm build-ha once, then kbook-vm restore-ha).
LAB_TIER=2
LAB_PARTS="single ha"
LAB_SNAPSHOT=prereqs
LAB_SNAPSHOT_ha=ha-prereqs
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
CP_IP=192.168.56.10
LB_IP=192.168.56.15
POD_CIDR=10.244.0.0/16

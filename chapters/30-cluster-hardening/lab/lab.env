# Tier 2: runs on cp1, starting from the VMs' cluster snapshot. Task 2 changes the
# control plane's manifests, so only a snapshot restore undoes the lab completely.
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=ch30-apps
BIN_DIR=/opt/ch30
MANIFESTS=/etc/kubernetes/manifests

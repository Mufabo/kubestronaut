# Tier 2: runs on cp1, starting from the VMs' cluster snapshot. Task 4 changes the
# API server and setup installs gVisor on the workers, so only a snapshot restore
# undoes the lab completely.
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=ch33-apps
LAB_SNAPSHOT_NS="ch33-apps ch33-legacy ch33-sandbox"
VIOLATIONS_FILE=/tmp/ch33-violations.txt
ENC_CONFIG=/etc/kubernetes/enc/enc.yaml
APISERVER_MANIFEST=/etc/kubernetes/manifests/kube-apiserver.yaml

LAB_TIER=1
LAB_PROFILE=cilium
# Parts: modes = kube-proxy's iptables and nftables modes (the default);
#        replace = Cilium's kube-proxy replacement instead of kube-proxy.
LAB_PARTS="modes replace"
# Both parts change kube-proxy and Cilium on every node, so setup builds a new
# cluster unless the current one is still untouched (lab/common.sh).
LAB_RESETS_CLUSTER=1
LAB_NS=ch54-modes
LAB_NS_modes=ch54-modes
LAB_NS_replace=ch54-replace
LAB_ANSWERS=/tmp/kbook/ch54

LAB_TIER=1
# Parts (the first is the default): a = shared seeded Pods, b1 = contexts,
# b2 = imperative creation with config objects, b2p = imperative creation
# with Pods only, b3 = permission checks, final = timed mini-exam.
LAB_PARTS="a b1 b2 b2p b3 final"
LAB_NS=ch03-kubectl
LAB_NS_a=ch03-kubectl
LAB_NS_b1=ch03-b1-a
LAB_SNAPSHOT_NS_b1="ch03-b1-a ch03-b1-b"
LAB_NS_b2=ch03-b2
LAB_NS_b2p=ch03-b2p
LAB_NS_b3=ch03-b3
LAB_NS_final=ch03-f1
LAB_SNAPSHOT_NS_final="ch03-f1 ch03-f2"
# Contexts the reader creates in part b1; require_lab_cluster accepts them
# (the lab-cluster marker check still applies to whatever they point at).
LAB_EXTRA_CONTEXTS="ch03-a ch03-b"

# Tier 2: runs on cp1, starting from the VMs' cluster snapshot. Setup breaks the
# cluster in four places; only a snapshot restore undoes everything.
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=ch27-trouble
CP_IP=192.168.56.10
CA_EXPIRY_FILE=/tmp/ch27-ca-expiry.txt
SCHEDULER_MANIFEST=/etc/kubernetes/manifests/kube-scheduler.yaml

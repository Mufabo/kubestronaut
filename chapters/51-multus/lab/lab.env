LAB_TIER=1
LAB_PROFILE=cilium
# Setup builds a brand-new cluster each time (it copies CNI plugins onto the
# nodes, installs Multus, and the reader changes Cilium's configuration).
LAB_RESETS_CLUSTER=1
LAB_NS=ch51-multus
# NetworkAttachmentDefinitions are not in the default snapshot types.
LAB_SNAPSHOT_CLUSTER=network-attachment-definitions.k8s.cni.cncf.io
# verify must not change the nodes' CNI configuration or routes either.
LAB_SNAPSHOT_NODES=1

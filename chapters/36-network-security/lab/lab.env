LAB_TIER=1
# Parts: policy = NetworkPolicies and a TLS Secret (the default);
#        mesh = mutual TLS with Istio, which the part installs and removes again.
LAB_PARTS="policy mesh"
LAB_NS=ch36-shop
LAB_NS_policy=ch36-shop
LAB_NS_mesh=ch36-mesh
LAB_SNAPSHOT_NS_mesh="ch36-mesh ch36-outside"
LAB_CERT_DIR=/tmp/ch36
LAB_CERT=/tmp/ch36/api.crt
LAB_KEY=/tmp/ch36/api.key

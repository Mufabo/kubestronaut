# Tier 2: runs on cp1, starting from the VMs' cluster snapshot. The restore in
# Task 3 rewrites etcd's data, so only a snapshot restore undoes it.
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=ch20-etcd
BACKUP_DIR=/opt/kbook
OLD_BACKUP=/opt/kbook/etcd-before.db
NEW_BACKUP=/opt/kbook/etcd-backup.db
REVISION_FILE=/tmp/ch20-revision.txt
RESTORE_DIR=/var/lib/etcd-restore
ETCD_MANIFEST=/etc/kubernetes/manifests/etcd.yaml

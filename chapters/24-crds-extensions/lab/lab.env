LAB_NS=ch24-crd
LAB_TIER=1
# A cluster-scoped CRD the reader creates in Task 1; setup and teardown remove it.
LAB_CRD=backups.ch24.example.com
LAB_ANSWER_VALIDATION=/tmp/ch24-validation.txt
LAB_ANSWER_NAMES=/tmp/ch24-names.txt
LAB_ANSWER_CRI=/tmp/ch24-cri.txt
# Task 6: the reader installs cert-manager with Helm into this Namespace; setup and
# teardown uninstall it and remove its CRDs.
CM_NS=ch24-cert-manager
CM_RELEASE=cert-manager

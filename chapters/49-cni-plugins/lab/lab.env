LAB_TIER=1
LAB_PROFILE=nocni
# Setup builds a brand-new cluster each time (the reader installs a CNI plugin
# on the nodes, and later changes how they route).
LAB_RESETS_CLUSTER=1
LAB_NS=ch49-cni
LAB_ANSWERS=/tmp/kbook/ch49
# verify must not change the nodes' CNI configuration or routes either.
LAB_SNAPSHOT_NODES=1

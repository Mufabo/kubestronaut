LAB_NS=ch34-supply
LAB_TIER=1
# Tasks 4 and 5 work in a second Namespace, which the image policy of Tasks 1 and 2 does not cover.
LAB_SCAN_NS=ch34-scan
LAB_SNAPSHOT_NS="ch34-supply ch34-scan"
LAB_POLICY=ch34-trusted-images
LAB_BINDING=ch34-trusted-images-binding
LAB_DIGEST_FILE=/tmp/ch34-digest.txt
LAB_CRITICAL_FILE=/tmp/ch34-critical.txt
# Task 6: a local registry, and the key pair the reader creates.
LAB_REGISTRY=localhost:5034
LAB_REGISTRY_CONTAINER=ch34-registry
LAB_REGISTRY_IMAGE=registry:2.8.3
LAB_COSIGN_KEY=/tmp/ch34-cosign.key
LAB_COSIGN_PUB=/tmp/ch34-cosign.pub

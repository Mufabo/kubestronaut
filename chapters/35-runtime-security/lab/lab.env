# Tier 2: runs on cp1, starting from the VMs' cluster snapshot. Setup installs Falco
# on node1; Task 1 changes the API server, so only a snapshot restore undoes the
# lab completely.
LAB_TIER=2
LAB_SNAPSHOT=cluster
LAB_CONTEXT=kbook-vm
LAB_CLUSTER_NAME=kbook-vm
LAB_NS=ch35-apps
FALCO_FILE=/tmp/ch35-falco.txt
FALCO_RULES=/etc/falco/rules.d/ch35-rules.yaml
AUDIT_POLICY=/etc/kubernetes/audit/policy.yaml
AUDIT_LOG=/var/log/kubernetes/audit/audit.log
APISERVER_MANIFEST=/etc/kubernetes/manifests/kube-apiserver.yaml
